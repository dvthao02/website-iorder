    "db:seed:v1-external-links": "tsx scripts/seed-v1-external-links.ts",
    "db:seed:cms": "pnpm db:seed:admin && pnpm db:seed:homepage && pnpm db:seed:navigation && pnpm db:seed:catalog-content && pnpm db:seed:listing-content && pnpm db:backfill-listing-pages && pnpm db:seed:site-profile && pnpm db:seed:v1-external-links && pnpm db:seed:contact-page && pnpm db:seed:v1-static-pages && pnpm db:seed:homepage-supporting && pnpm db:seed:v1-redirects && pnpm db:seed:v1-publishing-config",
