# Public DNS name. Caddy will issue and renew the TLS certificate automatically.
SITE_ADDRESS=example.com
ADMIN_SITE_ADDRESS=admin.example.com
# Giao diện quản trị Umami (thống kê truy cập).
ANALYTICS_SITE_ADDRESS=stats.example.com
APP_IMAGE_TAG=latest

# PostgreSQL. Mật khẩu mặc định theo quy ước <tên>.iOrder@2026 để dựng nhanh; ĐỔI sang chuỗi dài ngẫu nhiên trước khi mở ra Internet.
# (Mật khẩu có dấu @ vẫn dùng được trong DATABASE_URL do compose ghép; nếu đổi sang mật khẩu có ký tự đặc biệt khác như / ? # : thì không dùng được.)
POSTGRES_DB=iorder_v2
POSTGRES_USER=iorder
POSTGRES_PASSWORD=postgres.iOrder@2026

# Used to pseudonymize lead IP addresses and CMS login-rate-limit buckets.
LEAD_IP_HASH_SALT=replace_with_a_long_random_value

# Shared only by Backend and publish-web to authenticate cache invalidation over Docker's internal network.
PUBLISH_WEB_REVALIDATE_SECRET=replace_with_a_long_unique_cache_revalidation_secret

# SeaweedFS internal S3 credentials. Both are used only on the private Docker network.
S3_ACCESS_KEY_ID=replace_with_an_s3_access_key
S3_SECRET_ACCESS_KEY=replace_with_a_long_unique_s3_secret
S3_BUCKET=iorder-v2-media

# Chỉ dùng cho lần tạo tài khoản CMS đầu tiên. Mật khẩu mặc định theo quy ước <tên>.iOrder@2026 là mật khẩu ĐOÁN ĐƯỢC (có trong repo):
# CMS nằm trên Internet nên phải đổi ngay ở Tài khoản của tôi → Mật khẩu ngay sau lần đăng nhập đầu tiên.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin.iOrder@2026
INITIAL_ADMIN_NAME=Administrator

# Umami (thống kê truy cập). APP_SECRET: chuỗi ngẫu nhiên dài; khóa 2FA: 64 ký tự hex (openssl rand -hex 32).
UMAMI_APP_SECRET=replace_with_a_long_random_umami_secret
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace_with_64_hex_characters
# Điền sau khi đăng nhập Umami, thêm website và tạo API key; rồi chạy lại up -d.
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=

# Khóa chủ mã hóa các khóa API nhập ở CMS (Hệ thống → Kết nối & khóa API). KHÔNG BẮT BUỘC: để trống thì Super Admin bấm "Tạo khóa chủ" ở CMS và Backend
# tự cất khóa vào volume secrets-data (/data/secrets/master.key). Muốn tự đặt: openssl rand -base64 32 (biến này thắng tệp). KHÔNG dùng quy ước mật khẩu mặc định.
# Dù theo cách nào cũng phải sao lưu khóa chủ RIÊNG ngoài sao lưu database (tệp trong volume secrets-data, hoặc giá trị biến này vào trình quản lý mật khẩu):
# mất khóa chủ thì phải nhập lại mọi khóa đã lưu ở CMS.
SECRETS_MASTER_KEY=

# Giới hạn tài nguyên của container CMS (tùy chọn; mặc định bên trái dấu :- trong compose.production.yaml). Chưa đo trên VPS thật.
# ADMIN_MEM_LIMIT=384m
# ADMIN_HEAP_MB=256
# ADMIN_CPUS=1
# Website và Backend (xem docs/DEPLOYMENT.md; số đo trên bản chạy local, chưa đo trên VPS thật):
# WEBSITE_MEM_LIMIT=768m
# WEBSITE_HEAP_MB=512
# API_MEM_LIMIT=384m
# API_HEAP_MB=256

# Mã phiên bản đang chạy (tùy chọn, chuỗi ngắn như a1b2c3d): hiện ở CMS → Tình trạng hệ thống để biết đang chạy bản nào. Thường đặt lúc triển khai
# bằng APP_COMMIT=$(git rev-parse --short HEAD) thay vì ghi cố định ở đây.
APP_COMMIT=

# Google Search Console (tùy chọn, chỉ đọc). Dán nội dung tệp khóa JSON của tài khoản dịch vụ trên MỘT dòng, bọc trong nháy đơn.
# Không đưa khóa lên git. Để trống thì CMS báo "chưa nối". SEARCH_CONSOLE_PROPERTY chỉ cần khi muốn chọn thuộc tính cụ thể.
GOOGLE_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_PROPERTY=

# IndexNow: tự báo Bing/Yandex khi xuất bản hoặc sửa nội dung đã xuất bản. Tự bật, khóa tự sinh từ PUBLISH_WEB_REVALIDATE_SECRET
# (công khai tại SITE_ADDRESS/indexnow.txt) nên không cần điền gì. Chỉ gửi khi Cài đặt xuất bản có URL công khai và cho phép công cụ tìm kiếm.
# Muốn tắt: INDEXNOW_DISABLED=true. Muốn tự đặt khóa: INDEXNOW_KEY (8–128 ký tự chữ, số, gạch ngang).
INDEXNOW_DISABLED=
INDEXNOW_KEY=

# Công tắc khẩn cấp cho giới hạn số request theo IP của Backend. Để trống = bật (mặc định, nên giữ).
# Chỉ đặt 1 khi giới hạn chặn nhầm người dùng thật, rồi chạy lại: docker compose ... up -d api
RATE_LIMIT_DISABLED=
