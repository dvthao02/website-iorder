# Public DNS name. Caddy will issue and renew the TLS certificate automatically.
SITE_ADDRESS=example.com
CMS_SITE_ADDRESS=cms.example.com
APP_IMAGE_TAG=latest

# PostgreSQL. Generate a long unique password; never reuse development values.
POSTGRES_DB=iorder_v2
POSTGRES_USER=iorder
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password

# Used to pseudonymize lead IP addresses.
LEAD_IP_HASH_SALT=replace_with_a_long_random_value

# MinIO internal access credentials. The secret must have at least 8 characters.
S3_ACCESS_KEY_ID=replace_with_a_minio_access_key
S3_SECRET_ACCESS_KEY=replace_with_a_long_unique_minio_secret
S3_BUCKET=iorder-v2-media

# Used only for the one-time initial CMS seed. Do not use default credentials.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_initial_admin_password
INITIAL_ADMIN_NAME=Administrator
