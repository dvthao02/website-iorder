# Chỉ dùng cho môi trường phát triển cục bộ. Không commit file .env thật.
POSTGRES_DB=iorder_v2
POSTGRES_USER=iorder
# Mật khẩu mặc định theo quy ước <tên>.iOrder@2026. Trong DATABASE_URL dấu @ của mật khẩu phải viết là %40.
# Đổi mật khẩu ở đây KHÔNG đổi mật khẩu của database đã tạo sẵn (volume Docker giữ mật khẩu lúc khởi tạo): phải đổi cả hai cho khớp.
POSTGRES_PASSWORD=postgres.iOrder@2026
DATABASE_URL=postgresql://iorder:postgres.iOrder%402026@127.0.0.1:5433/iorder_v2

# Chỉ cần khi chạy `pnpm db:seed:admin`.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin.iOrder@2026
INITIAL_ADMIN_NAME=Administrator

# Lưu trữ tương thích S3: cả local (compose.yaml) và production (compose.production.yaml) chạy SeaweedFS.
# Cổng 9090 trên máy host được chuyển tới S3 API của SeaweedFS (8333 trong Docker).
S3_ENDPOINT=http://127.0.0.1:9090
S3_BUCKET=iorder-v2-media
S3_ACCESS_KEY_ID=replace_with_a_unique_local_access_key
S3_SECRET_ACCESS_KEY=replace_with_a_unique_local_secret
NEXT_PUBLIC_PUBLISH_WEB_URL=http://localhost:3000
# Chỉ khi chạy bản dev (pnpm dev:all) mà mở từ tên miền, IP công cộng hoặc tunnel: liệt kê tên máy đó (cách nhau dấu phẩy), rồi khởi động lại ba app.
# Thiếu thì trang hiện nhưng không bấm được vì trình duyệt bị chặn nạp JavaScript của máy chủ dev (xem cảnh báo "Blocked cross-origin request" ở cửa sổ chạy dev).
# ALLOWED_DEV_ORIGINS=iorder.vn,*.trycloudflare.com

# Làm mới cache website ngay sau khi lưu nội dung. Thiếu hai biến này thì website
# chỉ cập nhật sau 60 giây. Secret phải giống nhau ở backend và website.
PUBLISH_WEB_REVALIDATE_URL=http://localhost:3000/api/internal/revalidate
PUBLISH_WEB_REVALIDATE_SECRET=replace_with_a_long_random_local_secret

# Tự báo IndexNow (Bing, Yandex…) khi xuất bản/sửa nội dung đã xuất bản. Khóa tự sinh từ PUBLISH_WEB_REVALIDATE_SECRET nên không cần đặt.
# Chỉ gửi khi website có địa chỉ công khai (không phải localhost) và cho phép công cụ tìm kiếm, nên máy local không gửi gì.
# Tắt hẳn: INDEXNOW_DISABLED=true. Tự đặt khóa: INDEXNOW_KEY (8–128 ký tự chữ, số, gạch ngang).
INDEXNOW_DISABLED=
INDEXNOW_KEY=

# Thống kê truy cập Umami (tùy chọn): docker compose --profile analytics up -d,
# mở http://localhost:3005, tạo website và API key. Để trống thì CMS báo "chưa kết nối".
UMAMI_URL=http://localhost:3005
UMAMI_API_URL=http://localhost:3005
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# Google Search Console (tùy chọn, chỉ đọc): cho CMS thấy khách gõ gì trên Google. Để trống thì CMS báo "chưa nối".
# Khóa là tệp JSON của tài khoản dịch vụ (Google Cloud). Đặt tệp NGOÀI thư mục dự án và không đưa lên git. Chọn MỘT trong hai:
#   GOOGLE_SERVICE_ACCOUNT_FILE: đường dẫn tới tệp, ví dụ D:/bi-mat/iorder-search-console.json
#   GOOGLE_SERVICE_ACCOUNT_JSON: nội dung tệp trên một dòng, bọc trong nháy đơn (dùng cho Docker/máy chủ)
# SEARCH_CONSOLE_PROPERTY chỉ cần khi muốn chọn thuộc tính cụ thể (sc-domain:ten-mien.vn hoặc https://ten-mien.vn/); để trống thì tự chọn theo địa chỉ website.
# Kiểm tra: pnpm gsc:check
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_PROPERTY=

# Giao diện trang đăng nhập CMS. Để trống (nên dùng): theo bảng màu người dùng chọn ở "Giao diện CMS" (chọn "Giáng sinh" thì bật,
# bảng màu khác thì tắt); trình duyệt chưa chọn gì thì tự bật từ 15/11 đến hết 10/01 (giờ Việt Nam).
# Ép cho cả hệ thống, bỏ qua lựa chọn của người dùng: christmas | default. Xem thử không cần đổi biến: /admin/login?theme=christmas
CMS_LOGIN_THEME=

# Khóa chủ để mã hóa các khóa API Super Admin nhập ở CMS (Hệ thống → Kết nối & khóa API). KHÔNG BẮT BUỘC: để trống thì Super Admin bấm "Tạo khóa chủ" ở CMS,
# Backend tự sinh khóa ngẫu nhiên và cất vào tệp SECRETS_KEY_FILE (mặc định apps/api/.data/secrets-master.key khi chạy local; đã .gitignore).
# Muốn tự đặt: openssl rand -base64 32 (đúng 32 byte, base64); biến này thắng tệp. Không đoán được, không dùng quy ước mật khẩu.
# Cất bản sao riêng: mất khóa chủ thì phải nhập lại mọi khóa đã lưu ở CMS.
SECRETS_MASTER_KEY=
# SECRETS_KEY_FILE=
