# Local development only. Never commit the real .env file.
POSTGRES_DB=iorder_v2
POSTGRES_USER=iorder
POSTGRES_PASSWORD=iorder_dev_only
DATABASE_URL=postgresql://iorder:iorder_dev_only@127.0.0.1:5433/iorder_v2

# Required only when running `pnpm db:seed:admin`.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_local_password
INITIAL_ADMIN_NAME=Administrator

# S3-compatible storage for local development. compose.yaml runs Adobe S3Mock
# only as the local S3 endpoint; use a private MinIO/S3 endpoint in production.
S3_ENDPOINT=http://127.0.0.1:9090
S3_BUCKET=iorder-v2-media
S3_ACCESS_KEY_ID=replace_with_a_unique_local_access_key
S3_SECRET_ACCESS_KEY=replace_with_a_unique_local_secret
