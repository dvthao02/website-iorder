# Public DNS name. Caddy will issue and renew the TLS certificate automatically.
SITE_ADDRESS=example.com
CMS_SITE_ADDRESS=cms.example.com
# Giao diện quản trị Umami (thống kê truy cập).
ANALYTICS_SITE_ADDRESS=stats.example.com
APP_IMAGE_TAG=latest

# PostgreSQL. Generate a long unique password; never reuse development values.
POSTGRES_DB=iorder_v2
POSTGRES_USER=iorder
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password

# Used to pseudonymize lead IP addresses and CMS login-rate-limit buckets.
LEAD_IP_HASH_SALT=replace_with_a_long_random_value

# Shared only by Backend and publish-web to authenticate cache invalidation over Docker's internal network.
PUBLISH_WEB_REVALIDATE_SECRET=replace_with_a_long_unique_cache_revalidation_secret

# SeaweedFS internal S3 credentials. Both are used only on the private Docker network.
S3_ACCESS_KEY_ID=replace_with_an_s3_access_key
S3_SECRET_ACCESS_KEY=replace_with_a_long_unique_s3_secret
S3_BUCKET=iorder-v2-media

# Used only for the one-time initial CMS seed. Do not use default credentials.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_initial_admin_password
INITIAL_ADMIN_NAME=Administrator

# Umami (thống kê truy cập). APP_SECRET: chuỗi ngẫu nhiên dài; khóa 2FA: 64 ký tự hex (openssl rand -hex 32).
UMAMI_APP_SECRET=replace_with_a_long_random_umami_secret
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace_with_64_hex_characters
# Điền sau khi đăng nhập Umami, thêm website và tạo API key; rồi chạy lại up -d.
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
