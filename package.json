{
  "name": "iorder-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @iorder/publish-web dev",
    "dev:cms": "pnpm --filter @iorder/cms dev",
    "dev:backend": "pnpm --filter @iorder/backend dev",
    "build": "pnpm -r --filter \"@iorder/*\" build",
    "start": "pnpm --filter @iorder/publish-web start",
    "start:cms": "pnpm --filter @iorder/cms start",
    "start:backend": "pnpm --filter @iorder/backend start",
    "lint": "eslint apps src scripts",
    "test": "pnpm test:navigation && pnpm test:downloads",
    "test:downloads": "node --import tsx --test packages/core/src/server/support/support-downloads.service.test.ts",
    "test:navigation": "node --import tsx --test packages/core/src/server/navigation/navigation.service.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:v1-posts": "tsx scripts/seed-v1-posts.ts",
    "db:import:v1-offerings": "tsx scripts/import-v1-offerings.ts",
    "db:import:v1-media": "tsx scripts/import-v1-media.ts",
    "db:seed:homepage": "tsx scripts/seed-homepage.ts",
    "db:seed:navigation": "tsx scripts/seed-navigation.ts",
    "db:sync:navigation": "tsx scripts/sync-navigation-from-content.ts",
    "db:seed:catalog-content": "tsx scripts/seed-catalog-content.ts",
    "db:seed:listing-content": "tsx scripts/seed-listing-content.ts",
    "db:seed:contact-page": "tsx scripts/seed-contact-page.ts",
    "db:seed:v1-static-pages": "tsx scripts/seed-v1-static-pages.ts",
    "db:import:v1-testimonials": "tsx scripts/import-v1-testimonials.ts",
    "db:seed:homepage-supporting": "tsx scripts/seed-homepage-supporting.ts",
    "db:seed:site-profile": "tsx scripts/seed-site-profile.ts",
    "db:seed:v1-redirects": "tsx scripts/seed-v1-redirects.ts",
    "db:seed:v1-publishing-config": "tsx scripts/seed-v1-publishing-config.ts",
    "db:seed:v1-external-links": "tsx scripts/seed-v1-external-links.ts",
    "db:seed:cms": "pnpm db:seed:admin && pnpm db:seed:homepage && pnpm db:seed:navigation && pnpm db:seed:catalog-content && pnpm db:seed:listing-content && pnpm db:seed:site-profile && pnpm db:seed:v1-external-links && pnpm db:seed:contact-page && pnpm db:seed:v1-static-pages && pnpm db:seed:homepage-supporting && pnpm db:seed:v1-redirects && pnpm db:seed:v1-publishing-config",
    "db:import:v1-content": "pnpm db:seed:v1-posts && pnpm db:import:v1-offerings && pnpm db:import:v1-media && pnpm db:import:v1-testimonials"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.19.0"
}
